# Copy to .env and fill in. The council reads keys via LiteLLM.
# Option A — one key for all three models (recommended): OpenRouter.
OPENROUTER_API_KEY=

# Option B — direct provider keys (used if OpenRouter key is absent).
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=

# Live Kalshi execution (optional; paper mode needs none of this).
# The private key lives OUTSIDE the repo — point at it, never paste it here.
COUNCIL_MODE=paper
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Per-run safety cap in USD. The council aborts a run if projected spend exceeds this.
COUNCIL_BUDGET_USD=2.00

# Set true to require human approval in the dashboard before any shell/test execution
# or before writing files back to the workspace.
COUNCIL_REQUIRE_APPROVAL=true

# Edge rework knobs (blend-don't-beat). Defaults shown; all optional.
# EDGE_HORIZON_DAYS=7        # only debate markets resolving within this many days
# EXTREMIZE_ALPHA=1.3        # logit-space extremization of the council median (1.0 = off)
# SPREAD_BUFFER=0.01         # edge gate: buffer over the maker fee
# MIN_PROFIT=0.01            # edge gate: minimum profit per contract
# ORDER_TTL_TICKS=30         # cancel resting maker orders unfilled after this many ticks
# CALIBRATION_MIN_N=50       # resolved predictions required before live arming unlocks
# COUNCIL_CALIBRATION_OVERRIDE=false  # true = arm without proven edge (gamble knowingly)
