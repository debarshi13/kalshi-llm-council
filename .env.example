# Copy to .env and fill in. The council reads keys via LiteLLM.
# Option A — one key for all three models (recommended): OpenRouter.
OPENROUTER_API_KEY=

# Option B — direct provider keys (used if OpenRouter key is absent).
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=

# Per-run safety cap in USD. The council aborts a run if projected spend exceeds this.
COUNCIL_BUDGET_USD=2.00

# Set true to require human approval in the dashboard before any shell/test execution
# or before writing files back to the workspace.
COUNCIL_REQUIRE_APPROVAL=true
